    family-names: Mailland
repository-code: "https://github.com/lucasmailland/mnemosyne"
url: "https://getmnemosyne.ai"
license: Apache-2.0
version: 0.1.0
date-released: "2026-11-22"
keywords:
  - memory
  - ai-agents
  - retrieval
  - pgvector
  - bitemporal
  - multi-tenant
  - rls
  - mcp
  - rag
