# Mnemosyne self-host configuration.
# Copy this file to `.env`, uncomment ONE model block below and fill in its key.
#
#   cp .env.example .env
#   $EDITOR .env

# -------- Database --------
# Inside the compose network, postgres is reachable as the hostname `postgres`.
# If you point at an external Postgres, make sure pgvector is installed there.
DATABASE_URL=postgres://mnemo:mnemo@postgres:5432/mnemo
# Dedicated direct/session-pooled endpoint used only by the migration container.
# Production compose requires this explicitly and never falls back to DATABASE_URL.
MNEMO_MIGRATION_DATABASE_URL=postgres://mnemo:mnemo@postgres:5432/mnemo

# Postgres credentials (used only when the bundled postgres service starts).
POSTGRES_USER=mnemo
POSTGRES_PASSWORD=mnemo
POSTGRES_DB=mnemo
# Host port to expose Postgres on. Change if 5432 collides with a local install.
POSTGRES_PORT=5432

# -------- LLM / Embeddings --------
# No model API is chosen by default: Mnemosyne runs on the one you connect.
# Supported: openai | anthropic | google | cohere | mistral | voyage | bedrock | ollama
# Two halves:
#   completions (MNEMO_LLM_*)    session collapse, conflict checks, rerank, capture extraction
#   embeddings  (MNEMO_EMBED_*)  semantic recall; with no MNEMO_EMBED_PROVIDER the
#                                MNEMO_LLM_PROVIDER embeds, if it can
# With neither, the server still starts and logs what is missing: recall falls back to
# full-text and a write without a precomputed `vector` answers 501. With embeddings
# only, writes and semantic recall work but nothing is extracted or checked by a model.
# MNEMO_EMBED_DIMENSIONS must be the model's real width, one the schema has tables for
# (1024, 1536, 2048, 4096).
#
# --- Block A: OpenAI (one key for both halves) ---
# MNEMO_LLM_PROVIDER=openai
# MNEMO_LLM_API_KEY=sk-replace-me
# MNEMO_LLM_MODEL=gpt-4o-mini
# MNEMO_EMBED_MODEL=text-embedding-3-small
# MNEMO_EMBED_DIMENSIONS=1536
#
# --- Block B: Google Gemini (completions) + local bge-m3 (embeddings) ---
# Gemini's embedding models return 768 or 3072 dimensions, widths this schema has no
# table for, so embeddings come from Block D's bge-m3 (start with --profile local), or
# from OpenAI/Voyage via MNEMO_EMBED_PROVIDER.
# MNEMO_LLM_PROVIDER=google
# MNEMO_LLM_API_KEY=replace-me
# MNEMO_LLM_MODEL=gemini-2.5-flash
# ...plus the MNEMO_EMBED_* lines of Block D.
#
# --- Block C: Anthropic (completions) + Voyage (embeddings) ---
# Anthropic has no embeddings API, so a second provider embeds.
# MNEMO_LLM_PROVIDER=anthropic
# MNEMO_LLM_API_KEY=sk-ant-replace-me
# MNEMO_LLM_MODEL=claude-haiku-4-5
# MNEMO_EMBED_PROVIDER=voyage
# MNEMO_EMBED_API_KEY=pa-replace-me
# MNEMO_EMBED_MODEL=voyage-3.5
# MNEMO_EMBED_DIMENSIONS=1024
#
# --- Block D: local Ollama (opt-in: docker compose --profile local up -d) ---
# No key and no tokens. Pull what you use: docker exec mnemosyne-ollama ollama pull bge-m3
# Embeddings: bge-m3 (MIT licence, 1024 dims; measured on a bilingual corpus, a Spanish
# query found the English fact at precision@1 1.00, where mxbai-embed-large scored 0.00).
# MNEMO_EMBED_PROVIDER=ollama
# MNEMO_EMBED_BASE_URL=http://ollama:11434
# MNEMO_EMBED_MODEL=bge-m3
# MNEMO_EMBED_DIMENSIONS=1024
# bge-m3's cosines run lower than OpenAI's: the core reminder floor (0.7) would never fire.
# MNEMO_REMINDER_SEMANTIC_THRESHOLD=0.55
# A CPU-only Ollama is slow, the first embed after boot most of all.
# MNEMO_EMBED_TIMEOUT_MS=10000
# MNEMO_OLLAMA_NUM_THREAD=4
# MNEMO_WARM_MODELS_ON_BOOT=true
# Completions on Ollama too (optional): no model is chosen for you. Pick one whose licence
# fits your use: qwen2.5:3b, used here before, is under the Qwen Research License
# (non-commercial). The model writes durable memory (collapse turns sessions into facts and
# decisions), so a weak one stores confident nonsense; 0.5B-class models did. Pull it first.
# MNEMO_LLM_PROVIDER=ollama
# MNEMO_LLM_BASE_URL=http://ollama:11434
# MNEMO_LLM_MODEL=
#
# Other providers (cohere, mistral, bedrock, ...): set MNEMO_LLM_PROVIDER, MNEMO_LLM_API_KEY
# and MNEMO_LLM_MODEL the same way. Unset, MNEMO_LLM_MODEL is gpt-4o-mini in this compose
# file whatever the provider, so always set it.
# Defaults when unset: MNEMO_EMBED_MODEL text-embedding-3-small, MNEMO_EMBED_DIMENSIONS 1536
# (1024 with bedrock).

# Completion provider per task (optional). Each engine completion declares a task:
#   JUDGE     conflict classification, recall rerank, reminder conditions
#   SUMMARY   session collapse, capture extraction, compression
#   PREFILTER HyDE and anticipation queries
# A task without these runs on MNEMO_LLM_PROVIDER. _PROVIDER unset = the default vendor,
# inheriting its key, MNEMO_LLM_BASE_URL and MNEMO_LLM_MODEL. Another vendor inherits
# nothing and needs its own _API_KEY (except ollama), or the server refuses to start.
# _MODEL unset on another vendor = that vendor's default model.
# MNEMO_LLM_JUDGE_PROVIDER=anthropic
# MNEMO_LLM_JUDGE_API_KEY=sk-ant-replace-me
# MNEMO_LLM_JUDGE_MODEL=
# MNEMO_LLM_SUMMARY_PROVIDER=
# MNEMO_LLM_SUMMARY_API_KEY=
# MNEMO_LLM_SUMMARY_MODEL=
# MNEMO_LLM_PREFILTER_PROVIDER=
# MNEMO_LLM_PREFILTER_API_KEY=
# MNEMO_LLM_PREFILTER_MODEL=gpt-4o-mini

# Daily cap in USD on what MNEMO_LLM_PROVIDER spends on completions; resets at 00:00 UTC.
# Includes every per-task provider above.
# When reached, collapse, rerank, HyDE and conflict checks degrade (as if the LLM were down)
# until the reset. Embeddings are not capped, so writes keep working. Only models in the
# llm-providers price table are counted. Unset = no cap.
# MNEMO_LLM_DAILY_BUDGET_USD=5

# Which external providers receive the plaintext of confidential and restricted
# facts (stored encrypted; SECURITY.md §7):
#   none   neither: such facts are not embedded, so recall finds them only by exact repeat
#   embed  the embedder only (default): contradictions with them are not detected at
#          write time and a recall page holding one is not reranked
#   all    the embedder and the completion provider as well
# A local provider gets that text under any value: Ollama with no base URL, or a base URL
# whose host is localhost or an IP in 127.0.0.0/8, 10/8, 172.16/12, 192.168/16, ::1 or
# fc00::/7. A host name (a compose service such as http://ollama:11434 too) counts as
# external, since DNS decides where it goes; with every provider your own, set all.
# Providers configured per workspace through the API are always external. Any other
# value refuses to start.
# MNEMO_SENSITIVE_TEXT_TO_PROVIDERS=embed

# MNEMO_OLLAMA_NUM_THREAD (Ollama only): threads per request; unset lets Ollama take every
# core it sees, which inside Docker can be far slower. MNEMO_EMBED_TIMEOUT_MS: how long one
# embedding may take before the write is stored without a vector and recall falls back to
# full-text (default 3000). Block D sets both.

# -------- Ports (local stack) --------
# Every port is published on 127.0.0.1 only. OLLAMA_PORT moves the local Ollama
# off 11434 if one already runs on this machine. MNEMO_BIND=0.0.0.0 publishes the
# server to the network: do that only behind TLS, with docker-compose.prod.yml.
# OLLAMA_PORT=11434
# MNEMO_BIND=127.0.0.1

# -------- Security & Encryption --------
# Master key (32-byte hex string) for data encryption at rest
# Generate your own: openssl rand -hex 32  (never reuse a published example key)
# MNEMO_MASTER_KEY=

# -------- Redis --------
# Redis is required for session/episode operations and the ACT-R hot tier.
# Inside the compose network, redis is reachable as the hostname redis.
MNEMO_REDIS_URL=redis://redis:6379
# Host port to expose Redis on. Change if 6379 collides with a local install.
REDIS_PORT=6379

# -------- Server --------
# PORT controls which host port docker-compose maps the server container to.
# The container always listens on :3000 (set in docker-compose.override.yml).
# Default is 3939 for local dev to avoid colliding with other services on :3000.
# Change this if 3939 is already in use on your machine.
# With the production overlay and MNEMO_SERVER_REPLICAS > 1, set a range with one
# port per replica (e.g. 3939-3941) and point the edge proxy at all of them.
PORT=3939
# MNEMO_SERVER_REPLICAS=1

# Cleartext HTTP/2 (h2c) port for the gRPC service alone. PORT is HTTP/1.1, which carries
# Connect and gRPC-Web but not the bidirectional Session and FederationSync (HTTP 505) nor
# the gRPC protocol; set this to reach them. Must differ from PORT; empty: off. Same port
# inside the container and on the host: uncomment the ports line for it in the compose file.
# MNEMO_GRPC_PORT=50051

# trace | debug | info | warn | error. info is fine for prod.
LOG_LEVEL=info

# On SIGTERM/SIGINT the server drains for this many milliseconds, then logs
# server.shutdown_force_exit and exits 1. Default 45000; anything but a positive
# whole number refuses to start. Keep it below the platform's kill timeout
# (stop_grace_period: 60s in docker-compose.prod.yml, kill_timeout in fly.toml).
# MNEMO_SHUTDOWN_GRACE_MS=45000

# Data residency: the region this instance serves (e.g. eu-west-1). A workspace
# created here is pinned to it, and a request for a workspace pinned to another
# region answers 403 wrong_region. Workspaces created while it was unset have no
# region and pass anywhere. Unset (the default): single-region, no check.
# MNEMO_REGION=eu-west-1

# -------- Production overlay (docker-compose.prod.yml) --------
# The overlay refuses to start without these (docs/guides/PRODUCTION_DEPLOY.md).
# POSTGRES_PASSWORD above must be set too, not left at mnemo.
# MNEMO_APP_DB_PASSWORD=          # the app role's password (openssl rand -hex 32)
# DATABASE_URL_PROD=postgres://mnemo_app:<MNEMO_APP_DB_PASSWORD>@pgbouncer:5435/mnemo
# MNEMO_MASTER_KEY=               # openssl rand -hex 32
# MNEMO_KEY_PEPPER=               # openssl rand -hex 32 (to change it later, see MNEMO_KEY_PEPPER_PREVIOUS in docs/DEPLOYMENT.md)
# Password every Redis node of the overlay asks for (requirepass/masterauth).
# URL-safe, since it goes into the redis:// URL: openssl rand -hex 32
# REDIS_PASSWORD=
# The server's Redis; the overlay's redis-master by default, signed in with
# REDIS_PASSWORD. A plain redis:// URL: the client does not follow Sentinel.
# MNEMO_REDIS_URL_PROD=redis://:<REDIS_PASSWORD>@redis-master:6379/0
# Host port of pgBouncer, bound to 127.0.0.1.
# PGBOUNCER_PORT=5435
# Postgres session limits in ms (passed to migrate, which sets them on the app
# role, and to the server). Defaults: 60000, 15000, 60000.
# MNEMO_PG_STATEMENT_TIMEOUT_MS=60000
# MNEMO_PG_LOCK_TIMEOUT_MS=15000
# MNEMO_PG_IDLE_IN_TRANSACTION_TIMEOUT_MS=60000
# Bearer token for GET /metrics and /metrics/prometheus. With NODE_ENV=production
# (the overlay) and no token, both answer 404; with a token, a scrape must send
# Authorization: Bearer <token>. Generate: openssl rand -hex 32
# MNEMO_METRICS_TOKEN=

# -------- Dashboard --------
# Signs the dashboard session cookie. Without it the server runs headless and
# the dashboard cannot sign in. Required by the production overlay; at least
# 32 bytes or the server refuses to boot. Generate: openssl rand -hex 32
# MNEMO_DASHBOARD_SECRET=

# Registering the first API key over HTTP (POST /bootstrap, the dashboard's
# first-run page) needs a setup token. By default the server prints one in its
# log at startup, valid for 15 minutes. Set a fixed one here (16+ characters)
# only for unattended provisioning.
# MNEMO_SETUP_TOKEN=

# Webhooks are delivered over https and never to a loopback, private or
# link-local address, so that a webhook cannot be aimed at the services only
# this server can reach. If your receivers are internal on purpose (n8n on the
# same network, a local test server), opt in:
# MNEMO_WEBHOOK_ALLOW_HTTP=true
# MNEMO_WEBHOOK_ALLOW_PRIVATE=true
# Public HTTPS origin people open the dashboard at, used in the links shown in
# Members and invitations (a value saved in Installation > Settings wins).
# MNEMO_PUBLIC_BASE_URL=https://mnemo.example.com
# Host port of the dashboard container, bound to 127.0.0.1; the edge proxy on
# this host sends /dashboard/* to it.
# MNEMO_DASHBOARD_PORT=3300
# The dashboard's MNEMO_SERVER_URL (http://server:3000 in the overlay) is a
# build arg as well as a runtime variable: change it in the compose file and
# rebuild the image, setting it here alone has no effect on the rewrites.

# -------- Plugins --------
# Plugins run inside the server process with its full privileges: list only
# code you trust. Comma-separated npm package names and/or built-ins by name
# (builtin:webhook-notify, builtin:outline-sync, ...). An unknown name is
# logged as plugin.load_failed and the server boots without it.
# MNEMO_PLUGINS=builtin:webhook-notify
# Per-plugin config, read into that plugin's ctx.config:
# MNEMO_PLUGIN_<ID>__<KEY>, with <ID> the plugin id in UPPER_SNAKE and <KEY>
# the config key in UPPER_SNAKE (OUTLINE_API_URL becomes outlineApiUrl).
# Compose passes only the variables listed in the server's environment, so add
# each one there too (docker-compose.yml has a commented example).
# MNEMO_PLUGIN_WEBHOOK_NOTIFY__URL=https://hooks.example.com/mnemo
# A plugin with sync() or verify() runs them in the workspace
# MNEMO_PLUGIN_<ID>__WORKSPACE_ID names; without it the server skips them.
# sync() runs every syncInterval the plugin declares, or else every
# MNEMO_PLUGIN_SYNC_INTERVAL_MS (default 3600000). verify() runs daily over
# facts up to MNEMO_PLUGIN_<ID>__MAX_SENSITIVITY (default internal).
# MNEMO_PLUGIN_OUTLINE_SYNC__WORKSPACE_ID=00000000-0000-0000-0000-000000000000
# MNEMO_PLUGIN_SYNC_INTERVAL_MS=3600000

# -------- Federation --------
# This server's federation id (how other servers register it) and its Ed25519
# signing key (PEM). Both are needed to pull from peers; peers pin the public key.
# MNEMO_FED_PEER_ID=acme.example
# MNEMO_FEDERATION_PRIVATE_KEY=   # openssl genpkey -algorithm ed25519
# Behind a TLS-terminating proxy that overwrites x-mnemo-tls-protocol (and drops
# any client copy) on every request:
# MNEMO_FED_TLS_PROXY=true
# Address that proxy connects from: the proxy headers count only on its connections
# (docs/architecture/MTLS_BOUNDARY.md has an nginx example).
# MNEMO_TRUSTED_PROXY_IP=10.0.0.2
# When this server pulls from a peer whose proxy requires a client certificate
# (ssl_verify_client on): PEM files, the certificate issued for this server's
# federation key. Set both or neither; an unreadable file stops the boot.
# MNEMO_FED_CLIENT_CERT_FILE=/etc/mnemo/fed-client.crt
# MNEMO_FED_CLIENT_KEY_FILE=/etc/mnemo/fed-client.key
# CA that verifies peers' TLS certificates instead of the system roots (optional).
# MNEMO_FED_CA_FILE=/etc/mnemo/peers-ca.crt
# Development only, refused with NODE_ENV=production: accept peers over plain HTTP.
# MNEMO_FED_INSECURE_TRANSPORT=true
