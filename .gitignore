packages/dashboard/e2e/.empty-session.json
packages/dashboard/e2e/.reader-session.json

# Python bytecode (sdk-python test runs)
__pycache__/
*.pyc

# Backup copies left by editors and scripts
*.bak

# Python packaging and tooling (sdk-python)
*.egg-info/
.venv/
.pytest_cache/

# Next.js regenerates this on every build/dev/typegen (and flips its imports
# between .next/types and .next/dev/types), so it is not versioned.
next-env.d.ts

# Local agent working state: briefs, audits, screenshots, handoffs
.superpowers/
.claude/
HANDOFF.md

# Copied from the root LICENSE by each package's prepack script
packages/*/LICENSE

# Generated by the CLI prebuild (scripts/sync-plugin.cjs) from packages/plugin
packages/cli/plugin/
