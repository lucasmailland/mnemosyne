# benchmark output artifact (regenerated by `bench:json`; baseline is committed)
packages/core/bench-out.json

# Benchmark artifacts (regenerated on each run)
bench-results.json

# Throwaway HOME folders used for manual CLI runs
.scratch-home/

# Dashboard Playwright e2e artifacts
packages/dashboard/e2e/.state.json
packages/dashboard/test-results/
packages/dashboard/playwright-report/
