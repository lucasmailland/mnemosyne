{
  "formatVersion": 1,
  "tool": "memory_search",
  "inputSchema": {
    "properties": {
      "actorId": {
        "description": "Exact stored actorId (e.g. \"key:<id>\"; not a userId).",
        "type": "string"
      },
      "kinds": {
        "description": "Default: fact, decision, strategy, workflow, skill, episode, entities. task, event, reasoning only if listed.",
        "items": {
          "enum": [
            "fact",
            "decision",
            "strategy",
            "workflow",
            "skill",
            "episode",
            "task",
            "event",
            "reasoning",
            "entity"
          ],
          "type": "string"
        },
        "minItems": 1,
        "type": "array"
      },
      "limit": {
        "description": "Default 5, max 20.",
        "maximum": 20,
        "minimum": 1,
        "type": "integer"
      },
      "query": {
        "description": "Free text: what you want to search for by meaning.",
        "minLength": 1,
        "type": "string"
      },
      "scope": {
        "description": "Omit for all scopes; 'personal' = personal-workspace facts.",
        "enum": [
          "global",
          "conversation",
          "personal"
        ],
        "type": "string"
      },
      "scopeRef": {
        "description": "Filter by project (e.g. 'mnemosyne').",
        "type": "string"
      }
    },
    "required": [
      "query"
    ],
    "type": "object"
  }
}
