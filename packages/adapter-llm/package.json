{
  "name": "@mnemo-ai/adapter-llm",
  "version": "3.1.5-alpha.0",
  "private": true,
  "description": "LLM adapter for Mnemosyne — thin wrapper around @mnemo-ai/llm-providers implementing LLMAdapter port.",
  "license": "Apache-2.0",
  "author": "Lucas Mailland",
  "homepage": "https://getmnemosyne.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lucasmailland/mnemosyne.git",
    "directory": "packages/adapter-llm"
  },
  "bugs": {
    "url": "https://github.com/lucasmailland/mnemosyne/issues"
  },
  "keywords": [
    "mnemosyne",
    "llm",
    "embeddings",
    "openai",
    "adapter",
    "llm-providers"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "prepack": "cp ../../LICENSE LICENSE",
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "clean": "rm -rf dist .turbo",
    "typecheck": "tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@mnemo-ai/types": "workspace:*"
  },
  "peerDependencies": {
    "@mnemo-ai/llm-providers": "workspace:*"
  },
  "devDependencies": {
    "@mnemo-ai/llm-providers": "workspace:*",
    "@types/node": "^26.6.5",
    "tsup": "^9.0.0",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
