{
  "name": "@mnemo-ai/dashboard",
  "version": "3.6.0-alpha.0",
  "private": true,
  "description": "Mnemosyne web dashboard — observability, configuration, and interactive recall (Next.js 15)",
  "scripts": {
    "dev": "pnpm --filter \"@mnemo-ai/dashboard^...\" build && next dev",
    "build": "next build",
    "lint": "node scripts/check-arbitrary-values.mjs",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit && tsc --noEmit -p e2e/tsconfig.json",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@mnemo-ai/types": "workspace:*",
    "clsx": "^2.1.1",
    "next": "^16.4.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-force-graph-2d": "^1.27.0",
    "react-force-graph-3d": "^1.26.0",
    "tailwind-merge": "^3.3.1",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/three": "0.184.1",
    "jsdom": "^25.0.1",
    "server-only": "^0.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "7.0.2",
    "vitest": "^4.1.12"
  }
}
