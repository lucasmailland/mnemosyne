{
  "name": "@mnemo-ai/cup",
  "version": "0.1.0",
  "private": true,
  "description": "Cognitive Upgrade Protocol — deterministic v2→v3 data migration (mnemo-migrate CLI).",
  "license": "Apache-2.0",
  "author": "Lucas Mailland",
  "homepage": "https://getmnemosyne.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lucasmailland/mnemosyne.git",
    "directory": "packages/cup"
  },
  "bugs": {
    "url": "https://github.com/lucasmailland/mnemosyne/issues"
  },
  "keywords": [
    "mnemosyne",
    "migration",
    "etl",
    "cup",
    "cognitive-upgrade",
    "v2",
    "v3"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "prepack": "cp ../../LICENSE LICENSE",
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "clean": "rm -rf dist .turbo",
    "typecheck": "tsc -p tsconfig.test.json"
  },
  "bin": {
    "mnemo-migrate": "./dist/migrate.js"
  },
  "dependencies": {
    "@mnemo-ai/llm-providers": "workspace:*",
    "@mnemo-ai/types": "workspace:*",
    "postgres": "^3.4.9"
  },
  "peerDependencies": {
    "@mnemo-ai/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsup": "^9.0.0",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
