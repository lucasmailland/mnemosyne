{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://mnemosyne.dev/schemas/v3/graph",
  "title": "GraphResponse",
  "description": "GET /graph — Memory Graph snapshot (typed nodes + typed relations). packages/server/src/routes/graph.ts.",
  "type": "object",
  "required": ["nodes", "edges", "meta"],
  "properties": {
    "nodes": { "type": "array" },
    "edges": { "type": "array" },
    "meta": {
      "type": "object",
      "required": ["entityCount", "episodeCount", "decisionCount", "relationCount"],
      "properties": {
        "entityCount": { "type": "integer" },
        "episodeCount": { "type": "integer" },
        "decisionCount": { "type": "integer" },
        "relationCount": { "type": "integer" }
      }
    }
  },
  "additionalProperties": true
}
