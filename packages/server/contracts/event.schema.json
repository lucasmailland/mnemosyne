{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Event",
  "type": "object",
  "required": ["id", "workspaceId", "type"],
  "properties": {
    "id": { "type": "string" },
    "workspaceId": { "type": "string" },
    "type": { "type": "string" },
    "payload": { "type": "object" },
    "occurredAt": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": true
}
