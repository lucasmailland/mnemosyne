{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://mnemosyne.dev/schemas/v3/reasoning",
  "title": "MnemoReasoning",
  "description": "A cached chain-of-thought reasoning record in the Mnemosyne v3 cognitive store.",
  "type": "object",
  "required": [
    "id",
    "workspaceId",
    "question",
    "chain",
    "conclusion",
    "successCount",
    "failureCount",
    "worth",
    "status",
    "usageCount",
    "createdAt",
    "updatedAt",
    "metadata"
  ],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "workspaceId": { "type": "string", "minLength": 1 },
    "agentId": { "type": ["string", "null"] },
    "question": { "type": "string", "minLength": 1 },
    "chain": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["step", "reasoning"],
        "properties": {
          "step": { "type": "number" },
          "reasoning": { "type": "string" },
          "conclusion": { "type": "string" }
        }
      }
    },
    "conclusion": { "type": "string" },
    "successCount": { "type": "number" },
    "failureCount": { "type": "number" },
    "worth": { "type": "number" },
    "topicKey": { "type": ["string", "null"] },
    "status": {
      "type": "string",
      "enum": ["active", "archived", "pruned", "quarantined", "golden"]
    },
    "lastUsedAt": { "type": ["string", "null"] },
    "usageCount": { "type": "number" },
    "validFrom": { "type": "string" },
    "validTo": { "type": ["string", "null"] },
    "metadata": { "type": ["object", "null"] },
    "createdAt": { "type": "string" },
    "updatedAt": { "type": "string" }
  },
  "additionalProperties": true
}
