{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://mnemosyne.dev/schemas/v3/citation",
  "title": "Citation",
  "description": "A source-span citation linking a memory primitive (fact/decision/entity/episode) back to its provenance. Read-only surface — writes are extraction-pipeline-only. GET /citations (packages/server/src/routes/citations.ts).",
  "type": "object",
  "required": [
    "id",
    "workspaceId",
    "memoryKind",
    "memoryId",
    "sourceKind",
    "sourceId",
    "extractorModel",
    "extractorPromptVersion",
    "judgeModel",
    "judgeRelationId",
    "evidenceExcerpt",
    "createdAt"
  ],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "workspaceId": { "type": "string", "minLength": 1 },
    "memoryKind": {
      "type": "string",
      "enum": ["fact", "decision", "entity", "episode"]
    },
    "memoryId": { "type": "string", "minLength": 1 },
    "sourceKind": {
      "type": "string",
      "enum": [
        "message",
        "document",
        "tool_call",
        "llm_extraction",
        "user_edit",
        "agent_save",
        "imported"
      ]
    },
    "sourceId": { "type": ["string", "null"] },
    "extractorModel": { "type": ["string", "null"] },
    "extractorPromptVersion": { "type": ["string", "null"] },
    "judgeModel": { "type": ["string", "null"] },
    "judgeRelationId": { "type": ["string", "null"] },
    "evidenceExcerpt": { "type": ["string", "null"] },
    "createdAt": { "type": "string" }
  },
  "additionalProperties": true
}
