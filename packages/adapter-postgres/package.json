{
  "name": "@mnemo-ai/adapter-postgres",
  "version": "0.1.0",
  "private": true,
  "description": "PostgreSQL + Drizzle ORM storage adapter for Mnemosyne — implements StorageAdapter port.",
  "license": "Apache-2.0",
  "author": "Lucas Mailland",
  "homepage": "https://getmnemosyne.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lucasmailland/mnemosyne.git",
    "directory": "packages/adapter-postgres"
  },
  "bugs": {
    "url": "https://github.com/lucasmailland/mnemosyne/issues"
  },
  "keywords": [
    "mnemosyne",
    "postgres",
    "drizzle",
    "storage",
    "adapter",
    "rls"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./migrate": {
      "types": "./dist/migrate.d.ts",
      "import": "./dist/migrate.js",
      "require": "./dist/migrate.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "migrations",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "prepack": "cp ../../LICENSE LICENSE",
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "migrate": "node dist/migrate.js",
    "mark-squash-applied": "node --experimental-strip-types scripts/mark-squash-applied.ts",
    "update-checksums": "node --experimental-strip-types scripts/mark-squash-applied.ts --update-checksums",
    "clean": "rm -rf dist .turbo",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@mnemo-ai/core": "workspace:*",
    "@mnemo-ai/types": "workspace:*",
    "@paralleldrive/cuid2": "^3.3.0"
  },
  "peerDependencies": {
    "drizzle-orm": ">=0.45.0 <1.0.0",
    "postgres": ">=3.4.0 <4.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "4.1.12",
    "drizzle-orm": "^0.45.2",
    "nanoid": "^6.0.1",
    "postgres": "^3.4.9",
    "testcontainers": "^12.2.1",
    "tsup": "^9.0.0",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
