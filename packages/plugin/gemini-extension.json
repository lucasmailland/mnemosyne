{
  "name": "mnemosyne",
  "description": "Persistent memory for AI coding agents",
  "version": "0.1.0",
  "contextFileName": "GEMINI.md",
  "mcpServers": {
    "mnemosyne": {
      "command": "npx",
      "args": ["-y", "@mnemo-ai/mcp"],
      "env": {
        "MNEMO_URL": "${MNEMO_URL}",
        "MNEMO_KEY": "${MNEMO_KEY}"
      }
    }
  }
}
