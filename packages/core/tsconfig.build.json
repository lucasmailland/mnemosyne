{
  "extends": "./tsconfig.json",
  "include": ["src/**/*"],
  "exclude": ["dist", "node_modules", "**/*.test.ts", "__tests__", "tests"],
  "compilerOptions": {
    "declaration": true,
    "emitDeclarationOnly": true,
    "noEmit": false,
    "incremental": false,
    "composite": false,
    "outDir": "dist"
  }
}
