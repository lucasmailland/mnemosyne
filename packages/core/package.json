{
  "name": "@mnemo-ai/core",
  "version": "3.6.0-alpha.0",
  "private": true,
  "description": "Cognitive memory primitives — bitemporal, multi-tenant, RLS-isolated.",
  "license": "Apache-2.0",
  "author": "Lucas Mailland",
  "homepage": "https://getmnemosyne.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lucasmailland/mnemosyne.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/lucasmailland/mnemosyne/issues"
  },
  "keywords": [
    "ai-memory",
    "rag",
    "vector-search",
    "pgvector",
    "multi-tenant",
    "rls",
    "bitemporal",
    "mnemosyne",
    "llm",
    "agents",
    "mcp",
    "model-context-protocol"
  ],
  "//": "type=module + dual output: tsup emits .js (ESM) and .cjs (CJS) so legacy require() callers keep working.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "mnemo-migrate": "./dist/migrate.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./db": {
      "types": "./dist/db.d.ts",
      "import": "./dist/db.js",
      "require": "./dist/db.cjs"
    },
    "./protocol": {
      "types": "./dist/protocol.d.ts",
      "import": "./dist/protocol.js",
      "require": "./dist/protocol.cjs"
    },
    "./graph": {
      "types": "./dist/graph.d.ts",
      "import": "./dist/graph.js",
      "require": "./dist/graph.cjs"
    },
    "./cognitive": {
      "types": "./dist/cognitive.d.ts",
      "import": "./dist/cognitive.js",
      "require": "./dist/cognitive.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "migrations",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "prepack": "cp ../../LICENSE LICENSE",
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "bench": "tsx src/benchmark/bench.ts",
    "bench:json": "BENCH_OUT=bench-results.json tsx src/benchmark/bench.ts",
    "bench:check": "tsx src/benchmark/check-regression.ts",
    "bench:quality": "tsx src/benchmark/run-quality-gate.ts",
    "clean": "rm -rf dist",
    "migrate": "node dist/migrate.js",
    "prepublishOnly": "pnpm clean && pnpm build"
  },
  "peerDependencies": {
    "drizzle-orm": ">=0.45.0 <1.0.0",
    "postgres": ">=3.4.0 <4.0.0"
  },
  "peerDependenciesMeta": {
    "postgres": {
      "optional": true
    }
  },
  "dependencies": {
    "@mnemo-ai/types": "workspace:*",
    "lru-cache": "^11.5.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^4.1.12",
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.9",
    "testcontainers": "^12.2.1",
    "tinybench": "^6.0.2",
    "tsup": "^9.0.0",
    "tsx": "^4.23.12",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
